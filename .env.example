# ============================================================================
# VEGA DELTA PLAN - VARIÁVEIS DE AMBIENTE (.env)
# ============================================================================

# Porta do Servidor (no Railway é injetada automaticamente, localmente usa fallback 4301)
PORT=4301
VITE_PORT=4300

# Provedor de Inteligência Artificial Oficial (OpenAI)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Supabase (Banco de Dados PostgreSQL & Storage de Documentos)
SUPABASE_URL=https://sua-instancia.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Segurança do Webhook da Evolution API (WhatsApp)
WEBHOOK_TOKEN=
RESPONDER_EM_GRUPOS=false

# Exibição de dados completos (CPF/RG) para perfis autorizados
MOSTRAR_DOCUMENTOS_COMPLETOS=true

# Controle de Cota e Orçamento da IA
LIMITE_RPM=10
LIMITE_RPD=250
ALERTA_RPD_PERCENTUAL=80
TETO_CUSTO_MENSAL=0
